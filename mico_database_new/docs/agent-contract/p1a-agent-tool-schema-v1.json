{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mico.example.invalid/contracts/p1a-agent-tool-request-v1.json",
  "title": "Mico P1-A Agent Tool Request",
  "description": "Strict request envelope for Java-controlled, read-only Agent Tools. Fixed tools use typed parameterized Java queries. The dedicated execute_read_query tool accepts an untrusted model SQL proposal only after Java read-only policy validation; Python never executes SQL or connects to MySQL.",
  "type": "object",
  "additionalProperties": false,
  "required": ["toolName", "runId", "toolCallId", "requesterId", "dataContractVersion", "requestedScopes", "arguments"],
  "properties": {
    "toolName": {
      "type": "string",
      "enum": ["resolve_study", "resolve_sample", "get_sample", "list_sample_profiles", "get_abundance_summary", "resolve_disease", "build_cohort", "submit_differential_analysis", "get_differential_summary", "read_analysis_dataset_page", "execute_read_query", "get_data_snapshot", "get_quality_summary"]
    },
    "runId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "toolCallId": {"type": "string", "minLength": 1, "maxLength": 128},
    "requesterId": {"type": "string", "minLength": 1, "maxLength": 128},
    "dataContractVersion": {"const": "v1"},
    "requestedScopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["mico:study:read", "mico:sample:read", "mico:abundance:read", "mico:ontology:read", "mico:cohort:read", "mico:analysis:submit", "mico:analysis:read", "mico:query:read", "mico:snapshot:read", "mico:quality:read"]
      }
    },
    "arguments": {"type": "object"}
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "toolName": {"const": "resolve_study"},
            "arguments": {
              "type": "object", "additionalProperties": false, "required": ["studyKey"],
              "properties": {"studyKey": {"type": "string", "minLength": 1}}
            }
          }
        },
        {
          "properties": {
            "toolName": {"const": "resolve_sample"},
            "arguments": {
              "type": "object", "additionalProperties": false, "minProperties": 1,
              "anyOf": [{"required": ["sampleAccession"]}, {"required": ["sourceSampleId"]}],
              "properties": {
                "sampleAccession": {"type": "string", "minLength": 1},
                "sourceSampleId": {"type": "string", "minLength": 1},
                "studyKey": {"type": "string", "minLength": 1},
                "limit": {"type": "integer", "minimum": 1, "maximum": 20}
              }
            }
          }
        },
        {
          "properties": {
            "toolName": {"const": "get_sample"},
            "arguments": {
              "type": "object", "additionalProperties": false, "required": ["recordProfileLocator"],
              "properties": {
                "recordProfileLocator": {
                  "type": "object", "additionalProperties": false,
                  "required": ["internalRecordId", "sourceSampleId"],
                  "properties": {
                    "internalRecordId": {"type": "integer", "minimum": 1},
                    "sourceSampleId": {"type": "string", "minLength": 1, "maxLength": 4096}
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "toolName": {"const": "list_sample_profiles"},
            "arguments": {
              "type": "object", "additionalProperties": false,
              "required": ["recordProfileLocator", "taxonomyVersion", "featureVersion", "sourceBatch"],
              "properties": {
                "recordProfileLocator": {
                  "type": "object", "additionalProperties": false,
                  "required": ["internalRecordId", "sourceSampleId"],
                  "properties": {
                    "internalRecordId": {"type": "integer", "minimum": 1},
                    "sourceSampleId": {"type": "string", "minLength": 1, "maxLength": 4096}
                  }
                },
                "taxonomyVersion": {"type": "string", "minLength": 1},
                "featureVersion": {"type": "string", "minLength": 1},
                "sourceBatch": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        {
          "properties": {
            "toolName": {"const": "get_abundance_summary"},
            "arguments": {
              "type": "object", "additionalProperties": false,
              "required": ["recordProfileLocator", "taxonomyVersion", "featureVersion", "sourceBatch"],
              "properties": {
                "recordProfileLocator": {
                  "type": "object", "additionalProperties": false,
                  "required": ["internalRecordId", "sourceSampleId"],
                  "properties": {
                    "internalRecordId": {"type": "integer", "minimum": 1},
                    "sourceSampleId": {"type": "string", "minLength": 1, "maxLength": 4096}
                  }
                },
                "taxonomyVersion": {"type": "string", "minLength": 1},
                "featureVersion": {"type": "string", "minLength": 1},
                "sourceBatch": {"type": "string", "minLength": 1},
                "limit": {"type": "integer", "minimum": 1, "maximum": 100}
              }
            }
          }
        },
        {
          "properties": {
            "toolName": {"const": "resolve_disease"},
            "arguments": {
              "type": "object", "additionalProperties": false, "required": ["rawLabel"],
              "properties": {
                "rawLabel": {"type": "string", "minLength": 1, "maxLength": 4096}
              }
            }
          }
        },
        {
          "properties": {
            "toolName": {"const": "build_cohort"},
            "arguments": {
              "type": "object", "additionalProperties": false, "required": ["comparisonId"],
              "properties": {
                "comparisonId": {"const": "t2d_vs_healthy_v1"}
              }
            }
          }
        },
        {
          "properties": {
            "toolName": {"const": "submit_differential_analysis"},
            "arguments": {
              "type": "object", "additionalProperties": false, "required": ["comparisonId"],
              "properties": {"comparisonId": {"const": "t2d_vs_healthy_v1"}}
            }
          }
        },
        {
          "properties": {
            "toolName": {"const": "get_differential_summary"},
            "arguments": {
              "type": "object", "additionalProperties": false, "required": ["analysisDatasetHandle"],
              "properties": {
                "analysisDatasetHandle": {"type": "string", "pattern": "^analysis-[0-9a-f]{32}$"}
              }
            }
          }
        },
        {
          "properties": {
            "toolName": {"const": "read_analysis_dataset_page"},
            "arguments": {
              "type": "object", "additionalProperties": false, "required": ["analysisDatasetHandle"],
              "properties": {
                "analysisDatasetHandle": {"type": "string", "pattern": "^analysis-[0-9a-f]{32}$"},
                "pageToken": {"type": "string", "minLength": 1},
                "pageSize": {"type": "integer", "minimum": 1, "maximum": 1000}
              }
            }
          }
        },
        {
          "properties": {
            "toolName": {"const": "execute_read_query"},
            "arguments": {
              "type": "object", "additionalProperties": false, "required": ["sql"],
              "properties": {
                "sql": {"type": "string", "minLength": 1, "maxLength": 16000},
                "limit": {"type": "integer", "minimum": 1, "maximum": 1000}
              }
            }
          }
        },
        {
          "properties": {
            "toolName": {"const": "get_data_snapshot"},
            "arguments": {
              "type": "object", "additionalProperties": false, "required": ["dataSnapshotId"],
              "properties": {"dataSnapshotId": {"type": "string", "minLength": 1}}
            }
          }
        },
        {
          "properties": {
            "toolName": {"const": "get_quality_summary"},
            "arguments": {
              "type": "object", "additionalProperties": false, "required": ["dataSnapshotId"],
              "properties": {"dataSnapshotId": {"type": "string", "minLength": 1}}
            }
          }
        }
      ]
    }
  ]
}
