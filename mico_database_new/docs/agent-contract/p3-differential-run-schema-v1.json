{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mico.example.invalid/contracts/p3-differential-run-v1.json",
  "title": "Mico P3 Differential Run Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["traceId", "runId", "taskId", "status", "analysisJobId"],
  "properties": {
    "traceId": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "minLength": 1},
    "taskId": {"type": "string", "minLength": 1},
    "status": {"enum": ["COMPLETED", "REJECTED", "FAILED", "NOT_IMPLEMENTED"]},
    "analysisJobId": {"type": "string", "pattern": "^job-[0-9a-f]{32}$"},
    "errorCode": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+$"},
    "report": {"anyOf": [{"$ref": "p3-differential-analysis-schema-v1.json"}, {"type": "null"}]},
    "artifact": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "analysisJobId", "artifactType", "schemaVersion", "contentHash", "dataSnapshotIds", "createdAt", "persistence", "replayable"],
      "properties": {
        "artifactId": {"type": "string", "pattern": "^artifact-[0-9a-f]{32}$"},
        "analysisJobId": {"type": "string", "pattern": "^job-[0-9a-f]{32}$"},
        "artifactType": {"const": "differential_report"},
        "schemaVersion": {"const": "p3-differential-report-v1"},
        "contentHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "dataSnapshotIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"type": "string", "pattern": "^transient-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}
        },
        "createdAt": {"type": "string", "format": "date-time"},
        "persistence": {"const": "transient"},
        "replayable": {"const": false}
      }
    }
  }
}
