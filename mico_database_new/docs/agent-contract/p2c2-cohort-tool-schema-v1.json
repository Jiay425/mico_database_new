{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mico.invalid/contracts/p2c2-cohort-tool-schema-v1.json",
  "title": "Mico P2-C2 cohort tool contract",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolName", "arguments"],
      "properties": {
        "toolName": {"const": "resolve_disease"},
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rawLabel"],
          "properties": {"rawLabel": {"type": "string", "minLength": 1, "maxLength": 4096}}
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolName", "arguments"],
      "properties": {
        "toolName": {"const": "build_cohort"},
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["comparisonId"],
          "properties": {"comparisonId": {"const": "t2d_vs_healthy_v1"}}
        }
      }
    }
  ],
  "$comment": "The Java transport envelope still has exactly toolName, runId, toolCallId and arguments. No SQL, table, where, patientId, subjectId or free cohort condition is permitted."
}
